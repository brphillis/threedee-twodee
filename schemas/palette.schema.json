{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:td2d:schema:palette:1",
  "title": "td2d palette",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Optional JSON Schema reference for editors. Ignored by td2d."
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+\\.\\d+$",
      "description": "Document schema version. Any 1.x.y version is accepted.",
      "examples": [
        "1.0.0"
      ]
    },
    "name": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Lowercase kebab-case name.",
      "examples": [
        "steel",
        "endesga-32"
      ]
    },
    "description": {
      "type": "string",
      "maxLength": 2000,
      "description": "Free-text note. Use this instead of comments."
    },
    "source": {
      "description": "Where the palette comes from.",
      "type": "string",
      "format": "uri"
    },
    "author": {
      "description": "Who made the palette.",
      "type": "string",
      "maxLength": 200
    },
    "colors": {
      "minItems": 1,
      "maxItems": 256,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^#[0-9a-fA-F]{6}$",
        "description": "sRGB colour as #rrggbb.",
        "examples": [
          "#a0693a"
        ]
      },
      "description": "Palette colours in index order."
    }
  },
  "required": [
    "schemaVersion",
    "name",
    "colors"
  ],
  "additionalProperties": false,
  "description": "A named list of colours.",
  "examples": [
    {
      "schemaVersion": "1.0.0",
      "name": "tiny",
      "colors": [
        "#000000",
        "#ffffff"
      ]
    }
  ]
}
