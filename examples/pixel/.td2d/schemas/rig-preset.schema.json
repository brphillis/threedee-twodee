{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:td2d:schema:rig-preset:1",
  "title": "td2d rig-preset",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Optional JSON Schema reference for editors. Ignored by td2d."
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+\\.\\d+$",
      "description": "Document schema version. Any 1.x.y version is accepted.",
      "examples": [
        "1.0.0"
      ]
    },
    "name": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Lowercase kebab-case name.",
      "examples": [
        "steel",
        "endesga-32"
      ]
    },
    "description": {
      "type": "string",
      "maxLength": 2000,
      "description": "Free-text note. Use this instead of comments."
    },
    "bones": {
      "maxItems": 128,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-z][a-zA-Z0-9]*(-[a-z0-9]+)*$",
            "description": "Bone name. Humanoid rigs use VRM 1.0 names.",
            "examples": [
              "hips",
              "leftUpperArm",
              "tail-tip"
            ]
          },
          "description": {
            "type": "string",
            "maxLength": 2000,
            "description": "Free-text note. Use this instead of comments."
          },
          "parent": {
            "description": "Parent bone. null makes this the root. A preset bone keeps its parent when omitted.",
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64,
                "pattern": "^[a-z][a-zA-Z0-9]*(-[a-z0-9]+)*$",
                "description": "Bone name. Humanoid rigs use VRM 1.0 names.",
                "examples": [
                  "hips",
                  "leftUpperArm",
                  "tail-tip"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "position": {
            "description": "Rest position of the joint in metres, relative to the parent joint (or the model origin for the root).",
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "items": false,
            "minItems": 3,
            "maxItems": 3,
            "examples": [
              [
                0,
                0.5,
                0
              ]
            ]
          },
          "rotation": {
            "description": "Rest rotation in degrees, Euler X then Y then Z. Default [0, 0, 0].",
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "items": false,
            "minItems": 3,
            "maxItems": 3,
            "examples": [
              [
                0,
                0.5,
                0
              ]
            ]
          },
          "limits": {
            "type": "object",
            "properties": {
              "x": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number",
                    "minimum": -360,
                    "maximum": 360
                  },
                  {
                    "type": "number",
                    "minimum": -360,
                    "maximum": 360
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2,
                "description": "Allowed range [min, max] in degrees."
              },
              "y": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number",
                    "minimum": -360,
                    "maximum": 360
                  },
                  {
                    "type": "number",
                    "minimum": -360,
                    "maximum": 360
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2,
                "description": "Allowed range [min, max] in degrees."
              },
              "z": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number",
                    "minimum": -360,
                    "maximum": 360
                  },
                  {
                    "type": "number",
                    "minimum": -360,
                    "maximum": 360
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2,
                "description": "Allowed range [min, max] in degrees."
              }
            },
            "additionalProperties": false,
            "description": "Allowed pose rotation per axis, in degrees from the rest pose (Euler X then Y then Z). Clips that go outside get W_CLIP_BONE_LIMIT.",
            "examples": [
              {
                "x": [
                  -10,
                  150
                ]
              }
            ]
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "description": "One bone (joint) of a rig.",
        "examples": [
          {
            "name": "leftUpperLeg",
            "parent": "hips",
            "position": [
              0.1,
              -0.05,
              0
            ]
          }
        ]
      },
      "description": "Every bone with its parent, rest position, rotation and limits. Parents come first."
    }
  },
  "required": [
    "schemaVersion",
    "name",
    "bones"
  ],
  "additionalProperties": false,
  "description": "A named rig, stored as presets/rig/<name>.json.",
  "examples": [
    {
      "schemaVersion": "1.0.0",
      "name": "pole",
      "bones": [
        {
          "name": "base",
          "parent": null,
          "position": [
            0,
            0,
            0
          ]
        },
        {
          "name": "top",
          "parent": "base",
          "position": [
            0,
            1,
            0
          ]
        }
      ]
    }
  ]
}
