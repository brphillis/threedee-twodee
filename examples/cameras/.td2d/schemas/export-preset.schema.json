{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:td2d:schema:export-preset:1",
  "title": "td2d export-preset",
  "type": "object",
  "properties": {
    "formats": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "aseprite-json",
          "manifest",
          "frames",
          "pixi",
          "phaser-atlas",
          "godot-spriteframes",
          "gif-preview"
        ],
        "description": "Output format identifier."
      },
      "description": "Formats to write. manifest is always written."
    },
    "png": {
      "description": "How sheet PNGs are written: indexed or RGBA, and compression.",
      "type": "object",
      "properties": {
        "indexed": {
          "type": "string",
          "enum": [
            "auto",
            "always",
            "never"
          ],
          "description": "auto writes indexed PNGs whenever a palette is set."
        },
        "compressionLevel": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9
        }
      },
      "additionalProperties": false
    },
    "aseprite": {
      "description": "Options for aseprite-json.",
      "type": "object",
      "properties": {
        "variant": {
          "type": "string",
          "enum": [
            "hash",
            "array"
          ],
          "description": "hash: frames keyed by name. array: frames in a list, each with a filename."
        },
        "frameNames": {
          "type": "string",
          "enum": [
            "index",
            "descriptive"
          ],
          "description": "index names frames 0, 1, 2 like Aseprite's \"{frame}\" item filename, which Phaser's createFromAseprite needs. descriptive names them \"<asset> (<clip>_<direction>) <n>.png\"."
        }
      },
      "additionalProperties": false
    },
    "godot": {
      "description": "Options for godot-spriteframes.",
      "type": "object",
      "properties": {
        "directory": {
          "type": "string",
          "pattern": "^res:\\/\\/([A-Za-z0-9_.-]+\\/)*$",
          "description": "Where the sheet images will live in the Godot project. Default res://."
        }
      },
      "additionalProperties": false
    },
    "gif": {
      "description": "Options for gif-preview.",
      "type": "object",
      "properties": {
        "scale": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8,
          "description": "Enlargement factor. Default 2."
        },
        "background": {
          "anyOf": [
            {
              "type": "string",
              "const": "transparent"
            },
            {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$",
              "description": "sRGB colour as #rrggbb.",
              "examples": [
                "#a0693a"
              ]
            }
          ],
          "description": "transparent, or a #rrggbb colour behind the sprites. Default transparent."
        }
      },
      "additionalProperties": false
    },
    "$schema": {
      "type": "string",
      "description": "Optional JSON Schema reference for editors. Ignored by td2d."
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+\\.\\d+$",
      "description": "Document schema version. Any 1.x.y version is accepted.",
      "examples": [
        "1.0.0"
      ]
    },
    "name": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Lowercase kebab-case name.",
      "examples": [
        "steel",
        "endesga-32"
      ]
    },
    "description": {
      "type": "string",
      "maxLength": 2000,
      "description": "Free-text note. Use this instead of comments."
    }
  },
  "required": [
    "schemaVersion",
    "name"
  ],
  "additionalProperties": false,
  "description": "A named set of export settings.",
  "examples": [
    {
      "schemaVersion": "1.0.0",
      "name": "phaser",
      "formats": [
        "aseprite-json",
        "manifest"
      ],
      "aseprite": {
        "frameNames": "index"
      }
    }
  ]
}
