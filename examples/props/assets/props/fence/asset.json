      },
      {
        "type": "box",
        "id": "rail",
        "material": "oak",
        "size": [1.9, 0.08, 0.05],
        "position": [0, 0.3, 0.07],
        "repeat": { "count": 2, "offset": [0, 0.4, 0] }
      }
    ]
