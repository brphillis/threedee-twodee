{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:td2d:schema:batch-manifest:1",
  "title": "td2d batch-manifest",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+\\.\\d+$",
      "description": "Document schema version. Any 1.x.y version is accepted."
    },
    "description": {
      "description": "Free-text note. Use this instead of comments.",
      "type": "string",
      "maxLength": 2000
    },
    "assets": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[a-z0-9][a-z0-9-]*(\\/[a-z0-9][a-z0-9-]*)*$",
            "description": "Asset id. Equals the directory path under assets/.",
            "examples": [
              "props/crate"
            ]
          },
          "overrides": {
            "description": "Asset settings to change for this run only, merged over the asset definition (for example { \"pixel\": \"pico-8\" }).",
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "description": "Assets to generate, in order, each with optional overrides."
    },
    "options": {
      "description": "Batch options; command-line flags take precedence.",
      "type": "object",
      "properties": {
        "concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "continueOnError": {
          "type": "boolean"
        },
        "failFast": {
          "type": "boolean"
        },
        "strict": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "assets"
  ],
  "additionalProperties": false,
  "description": "A list of assets to generate together, with optional per-asset overrides. Passed to td2d batch --manifest.",
  "examples": [
    {
      "schemaVersion": "1.0.0",
      "assets": [
        {
          "id": "props/crate"
        },
        {
          "id": "props/barrel",
          "overrides": {
            "pixel": "pico-8"
          }
        }
      ],
      "options": {
        "concurrency": 2
      }
    }
  ]
}
