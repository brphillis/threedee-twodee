{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:td2d:schema:camera-preset:1",
  "title": "td2d camera-preset",
  "type": "object",
  "properties": {
    "projection": {
      "type": "string",
      "const": "orthographic",
      "description": "Only orthographic projection is supported."
    },
    "pitch": {
      "type": "number",
      "minimum": -90,
      "maximum": 90,
      "description": "Degrees above the horizon the camera looks down from. 30 gives 2:1 pixel lines at 45 degrees of yaw."
    },
    "yawOffset": {
      "type": "number",
      "minimum": -360,
      "maximum": 360,
      "description": "Degrees added to every direction yaw."
    },
    "groundMargin": {
      "anyOf": [
        {
          "type": "string",
          "const": "auto"
        },
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 256
        }
      ],
      "description": "Pixels between the pivot (ground) line and the bottom edge of the frame. \"auto\" picks the smallest margin that keeps the footprint in front of the pivot inside the frame in every direction.",
      "examples": [
        "auto",
        4
      ]
    },
    "$schema": {
      "type": "string",
      "description": "Optional JSON Schema reference for editors. Ignored by td2d."
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+\\.\\d+$",
      "description": "Document schema version. Any 1.x.y version is accepted.",
      "examples": [
        "1.0.0"
      ]
    },
    "name": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Lowercase kebab-case name.",
      "examples": [
        "steel",
        "endesga-32"
      ]
    },
    "description": {
      "type": "string",
      "maxLength": 2000,
      "description": "Free-text note. Use this instead of comments."
    }
  },
  "required": [
    "projection",
    "pitch",
    "yawOffset",
    "groundMargin",
    "schemaVersion",
    "name"
  ],
  "additionalProperties": false,
  "description": "A named camera preset.",
  "examples": [
    {
      "schemaVersion": "1.0.0",
      "name": "dimetric",
      "projection": "orthographic",
      "pitch": 30,
      "yawOffset": 45,
      "groundMargin": "auto"
    }
  ]
}
